[Unit]
Description=MOVIVO — recuperação operacional do Vault após reboot
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/movivo
ExecStartPre=/usr/bin/docker compose up -d --no-deps vault
ExecStart=/usr/bin/python3 /opt/movivo/bin/provision-security.py --root /opt/movivo --environment production --vault
ExecStartPost=/usr/bin/docker compose up -d --no-deps vault-token-renewer
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
