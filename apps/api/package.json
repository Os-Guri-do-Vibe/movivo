{
  "name": "@movivo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend MOVIVO — monólito modular NestJS (CORE + esqueleto de domínio do C4 nível 3).",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node --enable-source-maps dist/main.js",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/database/migrate.ts",
    "db:seed": "tsx src/core/database/seed.ts",
    "db:seed:workout": "tsx src/core/database/seed-workout-demo.ts",
    "db:backfill-transitions": "tsx src/core/database/backfill-status-transitions.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('tsconfig.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "@movivo/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@resvg/resvg-js": "2.6.2",
    "argon2": "^0.45.1",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.4.0",
    "nestjs-pino": "5.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfmake": "^0.3.11",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
