{
  "name": "@movivo/web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend MOVIVO — Next.js 16 (App Router, React 19, Tailwind v4 + shadcn/ui com os tokens do design system \"O Pulso\").",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --webpack --port 3000",
    "build": "node ../../scripts/build-web.mjs",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "serve:e2e": "node ../../scripts/build-web.mjs && next start --port 3000",
    "clean": "node -e \"const{rmSync}=require('node:fs');for(const p of ['.next','dist','tsconfig.tsbuildinfo','next-env.d.ts'])rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@movivo/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "js-rich-body-highlighter": "0.1.1",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "posthog-js": "1.438.7",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "^30.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
